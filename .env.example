# AI provider configuration.
# Gemini is preferred when present. OpenAI is used when Gemini is missing or fails.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# APP_URL: The public URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://jogga.santosautomation.com"

# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
VITE_STRIPE_BILLING_PORTAL_URL=https://billing.stripe.com/p/login/4gM7sL6tEfHD0P7cdw1wY00

# Google Maps Configuration
VITE_GOOGLE_MAPS_API_KEY=

# Google Analytics 4 public Measurement ID, for example G-XXXXXXXXXX.
# This is safe to expose in the browser bundle.
VITE_GA_MEASUREMENT_ID=

# Cordova Google OAuth configuration.
# Required only for Cordova builds that use cordova-plugin-inappbrowser.
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_CORDOVA_GOOGLE_REDIRECT_URI=https://jogga.santosautomation.com/oauth/google/callback

# Optional server-side Google Health OAuth configuration.
# The app's Google Health button uses Firebase Google auth by default.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase Auth console setup:
# Enable Google sign-in and add authorized domains for localhost,
# jogga-fork-main.vercel.app, and jogga.santosautomation.com.
FIREBASE_WEB_API_KEY=

# Firebase Admin SDK, server-only. Required for Stripe webhook fulfillment.
# Prefer one JSON env var in production, or use the three split vars below.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
