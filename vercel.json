{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/((?!__/auth(?:/|$)).*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(self), usb=(), bluetooth=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://challenges.cloudflare.com https://apis.google.com https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://firebasestorage.googleapis.com https://www.googleapis.com https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://challenges.cloudflare.com https://accounts.google.com; frame-src 'self' https://challenges.cloudflare.com https://accounts.google.com https://*.firebaseapp.com; media-src 'self' blob: data:; worker-src 'self' blob:; manifest-src 'self'; form-action 'self' https://checkout.stripe.com"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://gen-lang-client-0872258010.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/api/checkout-session/:sessionId",
      "destination": "/api/dispatch?path=checkout-session&sessionId=:sessionId"
    },
    {
      "source": "/api/checkout-session",
      "destination": "/api/dispatch?path=checkout-session"
    },
    {
      "source": "/api/create-checkout-session",
      "destination": "/api/dispatch?path=create-checkout-session"
    },
    {
      "source": "/api/create-billing-portal-session",
      "destination": "/api/dispatch?path=create-billing-portal-session"
    },
    {
      "source": "/api/subscription-status",
      "destination": "/api/dispatch?path=subscription-status"
    },
    {
      "source": "/api/checkout-redirect",
      "destination": "/api/dispatch?path=checkout-redirect"
    },
    {
      "source": "/api/auth/strava/url",
      "destination": "/api/dispatch?path=auth/strava/url"
    },
    {
      "source": "/api/auth/strava/callback",
      "destination": "/api/dispatch?path=auth/strava/callback"
    },
    {
      "source": "/api/strava/sync",
      "destination": "/api/dispatch?path=strava/sync"
    },
    {
      "source": "/ai-running-coach",
      "destination": "/ai-running-coach/index.html"
    },
    {
      "source": "/ai-running-coach/",
      "destination": "/ai-running-coach/index.html"
    },
    {
      "source": "/5k-training-plan",
      "destination": "/5k-training-plan/index.html"
    },
    {
      "source": "/5k-training-plan/",
      "destination": "/5k-training-plan/index.html"
    },
    {
      "source": "/10k-training-plan",
      "destination": "/10k-training-plan/index.html"
    },
    {
      "source": "/10k-training-plan/",
      "destination": "/10k-training-plan/index.html"
    },
    {
      "source": "/marathon-training-plan",
      "destination": "/marathon-training-plan/index.html"
    },
    {
      "source": "/marathon-training-plan/",
      "destination": "/marathon-training-plan/index.html"
    },
    {
      "source": "/beginner-running-plan",
      "destination": "/beginner-running-plan/index.html"
    },
    {
      "source": "/beginner-running-plan/",
      "destination": "/beginner-running-plan/index.html"
    },
    {
      "source": "/half-marathon-plan",
      "destination": "/half-marathon-plan/index.html"
    },
    {
      "source": "/half-marathon-plan/",
      "destination": "/half-marathon-plan/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/terms/",
      "destination": "/terms/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/auth/google-health/callback",
      "destination": "/api/auth/google-health/callback"
    },
    {
      "source": "/auth/google-health/callback/",
      "destination": "/api/auth/google-health/callback"
    },
    {
      "source": "/auth/strava/callback",
      "destination": "/api/dispatch?path=auth/strava/callback"
    },
    {
      "source": "/auth/strava/callback/",
      "destination": "/api/dispatch?path=auth/strava/callback"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
